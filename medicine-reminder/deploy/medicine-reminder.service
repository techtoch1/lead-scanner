[Unit]
Description=Medicine reminder dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=medrem
Group=medrem
WorkingDirectory=/opt/medicine-reminder
ExecStart=/opt/medicine-reminder/.venv/bin/python run.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medicine-reminder/data

[Install]
WantedBy=multi-user.target
